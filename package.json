{
  "name": "lan-sync",
  "version": "0.3.0",
  "private": true,
  "description": "Обмен файлами и текстом между ПК и телефоном по локальной сети",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "build": "tsc -p tsconfig.json",
    "build:binary": "node --import tsx scripts/build-binary.mjs",
    "start": "node dist/server/index.js",
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@fastify/multipart": "^9.0.3",
    "@fastify/websocket": "^11.0.2",
    "archiver": "^8.0.0",
    "bonjour-service": "^1.3.0",
    "fastify": "^5.2.1",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "selfsigned": "^5.5.0"
  },
  "optionalDependencies": {
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/node": "^22.13.5",
    "@types/qrcode": "^1.5.5",
    "@types/qrcode-terminal": "^0.12.2",
    "esbuild": "^0.28.1",
    "postject": "^1.0.0-alpha.6",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
